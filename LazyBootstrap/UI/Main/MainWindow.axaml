<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:pages="clr-namespace:LazyBootstrap.UI.Pages"
                 x:Class="LazyBootstrap.MainWindow"
                 Title="LazyBootstrap"
                 Width="1560" Height="900"
                 MinWidth="1440" MinHeight="900"
                 Background="Transparent"
                 RootCornerRadius="0"
                 BackgroundAnimationEnabled="False"
                 CanResize="True"
                 WindowStartupLocation="CenterScreen">
    <suki:SukiWindow.Hosts>
        <suki:SukiDialogHost x:Name="DialogHost"/>
        <suki:SukiToastHost x:Name="ToastHost"/>
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.Styles>
        <Style Selector="suki|SukiSideMenu Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.FaIcon">
            <Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolidFamily}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Padding" Value="0,1,0,1"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ suki|GlassCard#PART_TitleBarBackground">
            <Setter Property="Background" Value="#F4141414"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ suki|GlassCard#AlternativeGlassMenuBackground">
            <Setter Property="Background" Value="#E6141414"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ Panel#PART_Root">
            <Setter Property="Background" Value="#86101010"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ suki|SukiMainHost /template/ suki|SukiBackground#PART_Background">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="suki|SukiSideMenu /template/ suki|GlassCard#Glass">
            <Setter Property="Background" Value="#F0141414"/>
            <Setter Property="BorderBrush" Value="#70FFFFFF"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="suki|SukiSideMenu /template/ Border#ContentBorder">
            <Setter Property="Background" Value="#D6101010"/>
            <Setter Property="BorderBrush" Value="#50FFFFFF"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>
    </suki:SukiWindow.Styles>

    <Grid>
        <suki:SukiSideMenu x:Name="MainSideMenu" IsSearchEnabled="False">
            <suki:SukiSideMenu.Items>
                <suki:SukiSideMenuItem Header="启动">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Classes="FaIcon" Text="&#xF04B;" FontSize="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <pages:LaunchPage x:Name="LaunchPageView"/>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="设定">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Classes="FaIcon" Text="&#xF013;" FontSize="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <pages:SettingsPage x:Name="SettingsPageView"/>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="显示器配置">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Classes="FaIcon" Text="&#xF390;" FontSize="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <pages:DisplayPage x:Name="DisplayPageView"/>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="工具">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Classes="FaIcon" Text="&#xF552;" FontSize="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <pages:ToolsPage x:Name="ToolsPageView"/>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="信息">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Classes="FaIcon" Text="&#xF05A;" FontSize="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <pages:InfoPage x:Name="InfoPageView"/>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>
            </suki:SukiSideMenu.Items>
        </suki:SukiSideMenu>

        <Canvas IsVisible="False" IsHitTestVisible="False">
            <TextBlock x:Name="StatusLabel" Text="就绪"/>
            <ProgressBar x:Name="StatusProgress" Width="200" Height="14" Minimum="0" Maximum="100"/>
        </Canvas>

        <Grid x:Name="RuntimeInstallOverlay" IsVisible="False" Opacity="1" ZIndex="100">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseInOut"/>
                </Transitions>
            </Grid.Transitions>
            <Border Background="{DynamicResource SukiPopupBackground}" Opacity="0.72"/>
            <suki:GlassCard HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="26"
                            CornerRadius="22"
                            MinWidth="360">
                <StackPanel Spacing="20" ClipToBounds="False">
                    <StackPanel.Styles>
                        <Style Selector="suki|CircleProgressBar /template/ Arc">
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </StackPanel.Styles>
                    <suki:CircleProgressBar x:Name="RuntimeProgressBar"
                                            Width="130" Height="130"
                                            StrokeWidth="11"
                                            HorizontalAlignment="Center"
                                            IsIndeterminate="True"/>
                    <TextBlock x:Name="RuntimeStatusText"
                               Text="正在准备安装运行库..."
                               HorizontalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </suki:GlassCard>
        </Grid>
    </Grid>
</suki:SukiWindow>
