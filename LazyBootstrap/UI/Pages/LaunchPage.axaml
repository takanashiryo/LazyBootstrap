<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LazyBootstrap.UI.Pages.LaunchPage">
    <Grid Margin="14" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*">
            <Button x:Name="ToggleLaunchLogButton" Grid.Column="0" Classes="Basic" Content="显示启动日志"/>
            <Grid Grid.Column="1"/>
        </Grid>

        <Grid x:Name="LaunchLogContainer" Grid.Row="1" IsVisible="False" Opacity="0">
            <ScrollViewer x:Name="LaunchLogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="LogOutputTextBlock"
                           FontSize="18"
                           TextWrapping="Wrap"
                           Opacity="1"/>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Bottom">
            <Button x:Name="GotoGameSettingsButton" Grid.Column="0" Classes="Basic">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="FaIcon" Text="&#xF085;" FontSize="14"/>
                    <TextBlock Text="设定游戏" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="OpenLogButton" Grid.Column="1" Classes="Basic" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="FaIcon" Text="&#xF15C;" FontSize="14"/>
                    <TextBlock Text="查看log" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Grid Grid.Column="2"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                <Button x:Name="KillProcessesButton" Classes="Danger">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="FaIcon" Text="&#xF00D;" FontSize="14"/>
                        <TextBlock Text="结束所有进程" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <SplitButton x:Name="StartButton" Classes="Flat" MinWidth="170">
                    <SplitButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Classes="FaIcon" Text="&#xF04B;" FontSize="14"/>
                            <TextBlock Text="启动" VerticalAlignment="Center"/>
                        </StackPanel>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem x:Name="StartAsphyxiaDevMenuItem" Header="以调试模式启动氧无"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
