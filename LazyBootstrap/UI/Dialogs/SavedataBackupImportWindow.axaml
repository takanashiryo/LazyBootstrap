<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 x:Class="LazyBootstrap.UI.Dialogs.SavedataBackupImportWindow"
                 Title="存档备份与导入"
                 Width="720"
                 Height="320"
                 Background="Transparent"
                 RootCornerRadius="0"
                 BackgroundAnimationEnabled="False"
                 CanResize="False"
                 WindowStartupLocation="CenterOwner">
    <suki:SukiWindow.Styles>
        <Style Selector="suki|SukiWindow /template/ suki|SukiMainHost /template/ suki|SukiBackground#PART_Background">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ suki|GlassCard#PART_TitleBarBackground">
            <Setter Property="Background" Value="#F4141414"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ Panel#PART_Root">
            <Setter Property="Background" Value="#86101010"/>
        </Style>

        <Style Selector="suki|SukiWindow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="suki|GlassCard">
            <Setter Property="Background" Value="#D6101010"/>
            <Setter Property="BorderBrush" Value="#50FFFFFF"/>
        </Style>
    </suki:SukiWindow.Styles>

    <Grid Margin="16" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*" RowSpacing="10">
        <TextBlock Grid.Row="0"
                   Text="*导入仅支持使用当前启动器备份的文件"
                   Foreground="{DynamicResource ErrorBrush}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

        <StackPanel x:Name="BackupProgressPanel" Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="False">
            <suki:CircleProgressBar Width="24" Height="24" StrokeWidth="4" IsIndeterminate="True"/>
            <TextBlock x:Name="BackupProgressText" Text="正在备份..." VerticalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <suki:GlassCard Grid.Column="0">
            <StackPanel Margin="16" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="备份" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="直接备份到启动目录下 savedata_backup 文件夹" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.72"/>
                <Button x:Name="BackupButton" Classes="Flat" Content="备份" HorizontalAlignment="Stretch"/>
            </StackPanel>
            </suki:GlassCard>

            <suki:GlassCard Grid.Column="1">
                <StackPanel Margin="16" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="导入" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="从备份文件恢复 asphyxia 与卡号文件" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.72"/>
                    <Button x:Name="ImportButton" Classes="Flat" Content="导入" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </suki:GlassCard>
        </Grid>
    </Grid>
</suki:SukiWindow>
