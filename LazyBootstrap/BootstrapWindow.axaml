<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 x:Class="LazyBootstrap.BootstrapWindow"
                 Title="SOUND VOLTEX LazyBootstrap"
                 Width="1180" Height="780"
                 MinWidth="1060" MinHeight="700"
                 WindowStartupLocation="CenterScreen">
    <suki:SukiWindow.Styles>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </suki:SukiWindow.Styles>

    <Grid RowDefinitions="*,Auto">
        <suki:SukiSideMenu x:Name="mainSideMenu" Grid.Row="0" IsSearchEnabled="False">
            <suki:SukiSideMenu.HeaderContent>
                <StackPanel Margin="12,10,12,12">
                    <TextBlock Text="LazyBootstrap" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="SukiUI 6.0.3" Opacity="0.75"/>
                </StackPanel>
            </suki:SukiSideMenu.HeaderContent>

            <suki:SukiSideMenu.Items>
                <suki:SukiSideMenuItem Header="启动">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M3,2 L13,8 L3,14 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <Grid Margin="14" RowDefinitions="*,Auto">
                            <suki:GlassCard>
                                <Grid Margin="16" RowDefinitions="Auto,*">
                                    <TextBlock Text="日志系统" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                    <TextBox x:Name="txtLogOutput"
                                             Grid.Row="1"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </suki:GlassCard>

                            <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                <Button x:Name="btnGotoGameSettings" Grid.Column="0" Content="游戏设定" Click="btnGotoGameSettings_Click"/>
                                <Grid Grid.Column="1"/>
                                <Button x:Name="btnOpenLog" Grid.Column="2" Content="打开日志" Click="btnOpenLog_Click"/>
                                <Button x:Name="btnKillProcesses" Grid.Column="3" Content="结束所有进程" Click="btnKillProcesses_Click"/>
                                <Button x:Name="btnStart" Grid.Column="4" Content="启动" MinWidth="84" Click="btnStart_Click"/>
                            </Grid>
                        </Grid>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="显示器布局">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M1,2 L15,2 L15,11 L1,11 Z M6,12 L10,12 L10,14 L6,14 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <Grid Margin="14" RowDefinitions="Auto,*" ColumnDefinitions="360,*" ColumnSpacing="14">
                            <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                                <TextBlock Text="显示配置" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1"/>
                                <ToggleSwitch x:Name="tglDisplayConfigEnabled" Grid.Column="2" VerticalAlignment="Center" IsChecked="False"/>
                                <ComboBox x:Name="cmbDisplayMode" Grid.Column="3" Width="120" SelectedIndex="1">
                                    <ComboBoxItem Content="单屏"/>
                                    <ComboBoxItem Content="双屏"/>
                                </ComboBox>
                                <Button x:Name="btnApplyDisplaySettings" Grid.Column="4" Content="应用设置" Click="btnApplyDisplaySettings_Click"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">
                                <suki:GlassCard>
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="1541.41" Height="1192.22">
                                            <Path Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent" Data="M11.73,178.39L2.51,371.71c-.05,1.02.09,2.04.42,3.01l13.07,38.81c1.58,4.69-1.32,9.7-6.17,10.67l-2.73.55c-4.73.95-7.63,5.75-6.26,10.37l59.54,201.54c.64,2.16.36,4.49-.77,6.44l-11.49,19.82c-1.11,1.91-1.4,4.18-.81,6.3l39.3,142.28c.41,1.49,1.23,2.83,2.37,3.87l27.03,24.74c1.14,1.04,1.96,2.38,2.37,3.86l33.56,121.08c1.75,6.3-4.22,12.02-10.44,10l-108.85-35.28c-4.17-1.35-8.66.81-10.21,4.91l-13.85,36.67c-.62,1.65-.7,3.46-.21,5.16l40.88,143.08c.5,1.75,1.57,3.29,3.04,4.36l10.49,7.69c1.76,1.29,2.94,3.24,3.26,5.4l5.67,37.7c.61,4.03,7.05,7,11.12,6.99h735.04c3.75-.01,11.47-5.1,12.39-8.74l10.26-40.63c.38-1.51,1.19-2.88,2.32-3.95l15.71-14.86c1.11-1.05,1.9-2.38,2.29-3.85l36-134.99c.41-1.54.36-3.17-.14-4.69l-12.71-38.55c-1.41-4.28-6.01-6.62-10.3-5.25l-110.65,35.45c-6.22,1.99-12.16-3.72-10.41-10.01l33.03-119c.42-1.52,1.28-2.89,2.46-3.94l30.73-27.26c1.2-1.06,2.06-2.46,2.48-4.01l36.93-137.32c.6-2.25.23-4.64-1.04-6.6l-14.03-21.65c-1.32-2.03-1.67-4.54-.97-6.85l60.26-198.13c1.62-5.31-2.4-10.66-7.95-10.6h0c-5.65.06-9.67-5.46-7.88-10.81l13.96-41.68c.31-.93.45-1.91.42-2.89l-6.8-195.03c-.19-5.51-5.66-9.27-10.87-7.48l-107.53,37.01c-6.68,2.3-12.95-4.36-10.26-10.89l21.4-51.91c2.42-5.86-2.45-12.14-8.73-11.26l-152.99,21.41c-1.79.25-3.45,1.09-4.72,2.38l-14.1,14.36c-1.53,1.56-3.61,2.44-5.79,2.46l-297.53,2.27c-2.45.02-4.78-1.06-6.35-2.93l-11.7-13.94c-1.3-1.54-3.12-2.56-5.11-2.85l-150.42-21.75c-6.08-.88-10.94,4.99-8.94,10.8l18.4,53.41c2.23,6.46-3.96,12.66-10.43,10.44l-105.94-36.4c-5.17-1.78-10.6,1.91-10.87,7.37Z"/>
                                            <Path Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent" Data="M161.34,239.32l50,100.99c.48.96,1.39,1.63,2.45,1.8l83.88,13.06c.51.08,1.02.04,1.51-.12l21.53-6.85c.32-.1.65-.15.99-.16l265.13-1.03c.42,0,.85.08,1.24.24l19.2,7.68c.58.23,1.2.29,1.81.18l80.72-14.54c1.01-.18,1.87-.82,2.34-1.72l51.94-99.48c1.04-2-.17-4.43-2.39-4.79l-54.37-8.98c-.39-.06-.76-.2-1.1-.39l-28.72-16.34c-.5-.28-1.06-.43-1.64-.43h-138.91c-.56,0-1.11.14-1.6.41l-18.16,10.03c-.49.27-1.04.41-1.6.41h-85.25c-.5,0-1-.11-1.45-.34l-20.86-10.19c-.45-.22-.95-.34-1.45-.34h-133.37c-.54,0-1.06.13-1.54.38l-30.35,15.92c-.31.16-.64.27-.99.33l-56.62,9.52c-2.19.37-3.4,2.74-2.41,4.73Z"/>
                                            <Ellipse Canvas.Left="749.85" Canvas.Top="274.62" Width="103.92" Height="103.92" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent"/>
                                            <Ellipse Canvas.Left="697.89" Canvas.Top="1043.43" Width="103.92" Height="103.92" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent"/>
                                            <Ellipse Canvas.Left="51.7" Canvas.Top="280.08" Width="103.92" Height="103.92" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent"/>
                                            <Ellipse Canvas.Left="103.67" Canvas.Top="1043.43" Width="103.92" Height="103.92" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent"/>
                                            <Rectangle Canvas.Left="252.43" Canvas.Top="403.37" Width="402.27" Height="628.73" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent"/>
                                            <Polygon Points="654.7,1191.71 252.69,1191.71 286.04,1054.68 626,1053.86" Stroke="{DynamicResource ThemeForegroundBrush}" StrokeThickness="5" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </suki:GlassCard>

                                <suki:GlassCard Grid.Row="1">
                                    <StackPanel Margin="14" Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Text="退出游戏后恢复显示器布局" VerticalAlignment="Center"/>
                                            <ToggleSwitch x:Name="chkNoRestoreRotation" Grid.Column="1" VerticalAlignment="Center" IsChecked="True"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Text="Windows触控屏设置" VerticalAlignment="Center"/>
                                            <Button x:Name="btnTouchPanel" Grid.Column="1" Content="打开" MinWidth="86" Click="btnTouchPanel_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </suki:GlassCard>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,*" RowSpacing="12">
                                <suki:GlassCard>
                                    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="10">
                                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,4">
                                            <TextBlock Text="主屏幕" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="主屏幕参数" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="显示器" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbMainScreen" Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Grid.Row="2" Text="旋转" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbRotation" Grid.Row="2" Grid.Column="1"/>
                                        <TextBlock Grid.Row="3" Text="分辨率" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbMainResolution" Grid.Row="3" Grid.Column="1"/>
                                        <TextBlock Grid.Row="4" Text="刷新率" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtMainRefreshRate" Grid.Row="4" Grid.Column="1" Watermark="输入刷新率"/>
                                    </Grid>
                                </suki:GlassCard>

                                <suki:GlassCard x:Name="cardSubScreen" Grid.Row="1">
                                    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="10">
                                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,4">
                                            <TextBlock Text="副屏幕" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="副屏幕参数" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="显示器" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbSubScreen" Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Grid.Row="2" Text="旋转" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbSubRotation" Grid.Row="2" Grid.Column="1"/>
                                        <TextBlock Grid.Row="3" Text="分辨率" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbSubResolution" Grid.Row="3" Grid.Column="1"/>
                                        <TextBlock Grid.Row="4" Text="刷新率" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtSubRefreshRate" Grid.Row="4" Grid.Column="1" Watermark="输入刷新率"/>
                                    </Grid>
                                </suki:GlassCard>
                            </Grid>
                        </Grid>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="游戏设定">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M8,1 L10,1.5 L10.8,3.2 L12.7,3.8 L13.2,6 L12,7.2 L12,8.8 L13.2,10 L12.7,12.2 L10.8,12.8 L10,14.5 L8,15 L6,14.5 L5.2,12.8 L3.3,12.2 L2.8,10 L4,8.8 L4,7.2 L2.8,6 L3.3,3.8 L5.2,3.2 L6,1.5 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <suki:GlassCard>
                                    <StackPanel Margin="14" Spacing="8">
                                        <TextBlock Text="基础设定" FontSize="16" FontWeight="SemiBold"/>
                                        <CheckBox x:Name="chkUsePreconfig" Content="使用预配置文件" IsChecked="True"/>
                                        <CheckBox x:Name="chkWindowed" Content="窗口化启动"/>
                                        <CheckBox x:Name="chkNoAsphyxia" Content="不启动氧无"/>
                                        <Button x:Name="btnEditConfig" Content="编辑 spicecfg" Click="btnEditConfig_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>

                                <suki:GlassCard>
                                    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="110,*" ColumnSpacing="10" RowSpacing="10">
                                        <TextBlock Grid.ColumnSpan="2" Text="服务器设定" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Grid.Row="1" Text="服务器地址" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtServerAddress" Grid.Row="1" Grid.Column="1" Watermark="http://localhost:8083"/>
                                        <TextBlock Grid.Row="2" Text="机台ID" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtPcbId" Grid.Row="2" Grid.Column="1"/>
                                    </Grid>
                                </suki:GlassCard>

                                <suki:GlassCard>
                                    <StackPanel Margin="14" Spacing="8">
                                        <TextBlock Text="高级选项" FontSize="16" FontWeight="SemiBold"/>
                                        <CheckBox x:Name="chkAdvNetDump" Content="网络抓包（NetDump）"/>
                                        <CheckBox x:Name="chkAdvAsphyxiaDebug" Content="调试模式启动氧无"/>
                                        <CheckBox x:Name="chkAdvDisableSubDisplay" Content="禁用副屏"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="窗口化模式" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbAdvWindowMode" Width="180">
                                                <ComboBoxItem Content="默认"/>
                                                <ComboBoxItem Content="无边框"/>
                                                <ComboBoxItem Content="可变窗口"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <CheckBox x:Name="chkAdvPCoreOptimization" Content="大小核优化"/>
                                        <CheckBox x:Name="chkAdvSubBorderless" Content="副屏无边框"/>
                                        <CheckBox x:Name="chkAdvShowCursorTouchSim" Content="显示光标 &amp; 触控模拟"/>
                                    </StackPanel>
                                </suki:GlassCard>

                                <suki:GlassCard>
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="AMD / Intel 显卡兼容层" FontSize="16" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="btnLoadCompat" Content="启用" Width="120" Click="btnLoadCompat_Click"/>
                                            <Button x:Name="btnUnloadCompat" Content="关闭" Width="120" Click="btnUnloadCompat_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="lblCompatStatus" Text="● 未知" VerticalAlignment="Center"/>
                                            <TextBlock Text="渲染模式" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbCompatType" Width="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                </suki:GlassCard>
                            </StackPanel>
                        </ScrollViewer>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="常用工具">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M2,3 L6,3 L6,1 L10,1 L10,3 L14,3 L14,14 L2,14 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <Grid Margin="14" RowDefinitions="Auto,*">
                            <TextBlock Text="常用工具" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                                <suki:GlassCard Grid.Row="0" Grid.Column="0">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="清除 Data_Mods 缓存" FontWeight="SemiBold"/>
                                        <Button x:Name="btnClearCache" Content="执行" Click="btnClearCache_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                                <suki:GlassCard Grid.Row="0" Grid.Column="1">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="添加防火墙规则" FontWeight="SemiBold"/>
                                        <Button x:Name="btnAddFirewallRule" Content="执行" Click="btnAddFirewallRule_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                                <suki:GlassCard Grid.Row="1" Grid.Column="0">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="打开音频控制面板" FontWeight="SemiBold"/>
                                        <Button x:Name="btnAudioPanel" Content="执行" Click="btnAudioPanel_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                                <suki:GlassCard Grid.Row="1" Grid.Column="1">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="安装运行库" FontWeight="SemiBold"/>
                                        <Button x:Name="btnInstallRuntime" Content="执行" Click="btnInstallRuntime_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                            </Grid>
                        </Grid>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="关于">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M8,1 A7,7 0 1 1 7.99,1 Z M7.2,6 L8.8,6 L8.8,12 L7.2,12 Z M7.2,4 L8.8,4 L8.8,5.2 L7.2,5.2 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <suki:GlassCard>
                                    <StackPanel Margin="14" Spacing="10" HorizontalAlignment="Center">
                                        <Border Width="220" Height="84" CornerRadius="12" Padding="10">
                                            <Grid>
                                                <TextBlock Text="图标" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="SOUND VOLTEX LazyBootstrap" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="启动器与配置管理工具" Opacity="0.8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </suki:GlassCard>

                                <suki:GlassCard>
                                    <Grid Margin="14" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="机台属性" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtCurrentVersion" Grid.Column="1" IsReadOnly="True"/>
                                        <TextBlock Text="当前游戏版本" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox x:Name="txtRevision" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsReadOnly="True"/>
                                    </Grid>
                                </suki:GlassCard>
                            </StackPanel>
                        </ScrollViewer>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>
            </suki:SukiSideMenu.Items>
        </suki:SukiSideMenu>

        <Border Grid.Row="1" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="statusLabel" Text="就绪" VerticalAlignment="Center"/>
                <ProgressBar x:Name="statusProgress" Width="200" Height="14" Minimum="0" Maximum="100" IsVisible="False"/>
            </StackPanel>
        </Border>
    </Grid>
</suki:SukiWindow>
