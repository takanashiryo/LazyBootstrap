<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 x:Class="LazyBootstrap.BootstrapWindow"
                 Title="SOUND VOLTEX LazyBootstrap"
                 Width="1560" Height="900"
                 MinWidth="1440" MinHeight="900"
                 CanResize="True"
                 WindowStartupLocation="CenterScreen">
    <suki:SukiWindow.Hosts>
        <suki:SukiDialogHost x:Name="DialogHost"/>
        <suki:SukiToastHost x:Name="ToastHost"/>
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.Styles>
        <Style Selector="suki|SukiSideMenu Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </suki:SukiWindow.Styles>

    <Grid>
        <suki:SukiSideMenu x:Name="mainSideMenu" IsSearchEnabled="False">
            <suki:SukiSideMenu.HeaderContent>
                <StackPanel Margin="12,10,12,12">
                    <TextBlock Text="LazyBootstrap" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="SukiUI 6.0.3" Opacity="0.75"/>
                </StackPanel>
            </suki:SukiSideMenu.HeaderContent>

            <suki:SukiSideMenu.Items>
                <suki:SukiSideMenuItem Header="启动">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M3,2 L13,8 L3,14 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <Grid Margin="14" RowDefinitions="*,Auto" RowSpacing="12">
                            <suki:GlassCard>
                                <Grid Margin="12">
                                    <TextBox x:Name="txtLogOutput"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                            </suki:GlassCard>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Bottom">
                                <Button x:Name="btnGotoGameSettings" Grid.Column="0" Classes="Basic" Click="btnGotoGameSettings_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="M22.7,19 L13.6,9.9 C14.5,7.6 14,5 12.3,3.3 C10.6,1.6 8,1.1 5.7,2 L9.6,5.9 L6.7,8.8 L2.8,4.9 C1.9,7.2 2.4,9.8 4.1,11.5 C5.8,13.2 8.4,13.7 10.7,12.8 L19.8,21.9 C20.2,22.3 20.8,22.3 21.2,21.9 L22.7,20.4 C23.1,20 23.1,19.4 22.7,19 Z" Width="14" Height="14"/>
                                        <TextBlock Text="设定游戏" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnOpenLog" Grid.Column="1" Classes="Basic" HorizontalContentAlignment="Left" Click="btnOpenLog_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="M2,2 L12,2 L12,14 L2,14 Z M4,5 L10,5 M4,8 L10,8 M4,11 L8,11" Width="14" Height="14"/>
                                        <TextBlock Text="查看log" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Grid Grid.Column="2"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="btnKillProcesses" Classes="Danger" Click="btnKillProcesses_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="M3,3 L13,13 M13,3 L3,13" Width="14" Height="14"/>
                                            <TextBlock Text="结束所有进程" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnStart" Classes="Flat Large" MinWidth="150" Click="btnStart_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PathIcon Data="M3,2 L13,8 L3,14 Z" Width="14" Height="14"/>
                                            <TextBlock Text="启动" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="设定">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M22.7,19 L13.6,9.9 C14.5,7.6 14,5 12.3,3.3 C10.6,1.6 8,1.1 5.7,2 L9.6,5.9 L6.7,8.8 L2.8,4.9 C1.9,7.2 2.4,9.8 4.1,11.5 C5.8,13.2 8.4,13.7 10.7,12.8 L19.8,21.9 C20.2,22.3 20.8,22.3 21.2,21.9 L22.7,20.4 C23.1,20 23.1,19.4 22.7,19 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <suki:BusyArea x:Name="settingsBusyArea" Margin="20,14" BusyText="spicecfg 运行中..." HorizontalAlignment="Center" MaxWidth="1240">
                            <suki:SettingsLayout Name="GameSettingsLayout" Margin="0,6,0,0">
                                <suki:SettingsLayout.Items>
                                    <generic:List x:TypeArguments="suki:SettingsLayoutItem">
                                        <suki:SettingsLayoutItem Header="基础">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Button x:Name="btnEditConfig" Classes="Flat" HorizontalAlignment="Stretch" Content="编辑 spicecfg" Click="btnEditConfig_Click"/>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="使用预配置文件" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkUsePreconfig" Grid.Column="1" IsChecked="False" IsCheckedChanged="chkUsePreconfig_CheckedChanged"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="不启动氧无" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkNoAsphyxia" Grid.Column="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="兼容层">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="启用兼容层" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="tglCompatLayer" Grid.Column="1" IsCheckedChanged="tglCompatLayer_IsCheckedChanged"/>
                                                        </Grid>
                                                        <suki:BusyArea x:Name="compatRenderModeBusyArea" BusyText="兼容层启用中...">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <RadioButton x:Name="rbCompatDx9on12" GroupName="CompatType" Classes="GigaChips" IsChecked="True" IsCheckedChanged="rbCompatMode_IsCheckedChanged">
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="dx9on12" FontSize="16" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="spice2x内置，最常用的模式" Opacity="0.7"/>
                                                                    </StackPanel>
                                                                </RadioButton>
                                                                <RadioButton x:Name="rbCompatDx9on12External" GroupName="CompatType" Classes="GigaChips" IsCheckedChanged="rbCompatMode_IsCheckedChanged">
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="dx9on12 (External)" FontSize="16" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="外置版，可能比内置的好" Opacity="0.7"/>
                                                                    </StackPanel>
                                                                </RadioButton>
                                                                <RadioButton x:Name="rbCompatDxvk" GroupName="CompatType" Classes="GigaChips" IsCheckedChanged="rbCompatMode_IsCheckedChanged">
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Text="dxvk" FontSize="16" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="Vulkan 转译模式" Opacity="0.7"/>
                                                                    </StackPanel>
                                                                </RadioButton>
                                                            </StackPanel>
                                                        </suki:BusyArea>
                                                        <TextBlock x:Name="lblCompatStatus" Text="" Opacity="0.75"/>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="服务器设定">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <ComboBox x:Name="cmbServerPreset" Width="220" HorizontalAlignment="Left"/>
                                                            <Button x:Name="btnAddServerPreset" Grid.Column="1" Content="新建预设" Click="btnAddServerPreset_Click" MinWidth="20" Classes="Flat"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="96,*" ColumnSpacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="服务器地址" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="txtServerAddress" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="96,*" ColumnSpacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="PCBID" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="txtPcbId" Grid.Column="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="游戏设定">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="禁用副屏" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvDisableSubDisplay" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="网络抓包（NetDump）" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvNetDump" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="大小核优化" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvPCoreOptimization" Grid.Column="1"/>
                                                        </Grid>
                                                        <TextBlock Text="针对 Intel第12代酷睿及之后的处理器" Opacity="0.7" FontSize="12" Margin="0,-20,0,0"/>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="显示光标 &amp; 触控模拟" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvShowCursorTouchSim" Grid.Column="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="图形设定">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="窗口化启动" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkWindowed" Grid.Column="1"/>
                                                        </Grid>
                                                        <TextBlock Text="开启时副屏也会窗口化" Opacity="0.7" FontSize="12" Margin="0,-20,0,0"/>
                                                        <Grid ColumnDefinitions="96,*" ColumnSpacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="窗口模式" VerticalAlignment="Center"/>
                                                            <ComboBox x:Name="cmbAdvWindowMode" Grid.Column="1" SelectedIndex="0">
                                                                <ComboBoxItem Content="默认"/>
                                                                <ComboBoxItem Content="无边框"/>
                                                                <ComboBoxItem Content="可变窗口"/>
                                                            </ComboBox>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="副屏无边框" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvSubBorderless" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="窗口置顶" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvWindowTopMost" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="96,*" ColumnSpacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="窗口大小" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="txtAdvWindowSize" Grid.Column="1" Watermark="1080,1920"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="使用单一显示适配器" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvSingleAdapter" Grid.Column="1"/>
                                                        </Grid>
                                                        <TextBlock Text="针对笔记本等独显核显混合输出设备，开启后仅连接主屏所属显卡" Opacity="0.7" FontSize="12" Margin="0,-20,0,0"/>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="图形（副屏）">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="窗口置顶" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvSubWindowTopMost" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="强制进行渲染" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvSubForceRender" Grid.Column="1"/>
                                                        </Grid>
                                                        <TextBlock Text="若副屏黑屏、闪烁、一帧一帧显示，可尝试开启" Opacity="0.7" FontSize="12" Margin="0,-20,0,0"/>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="原生触控输入" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvNativeTouch" Grid.Column="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="音频">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <Grid ColumnDefinitions="96,*" ColumnSpacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="ASIO驱动" VerticalAlignment="Center"/>
                                                        <TextBox x:Name="txtAdvAsioDriver" Grid.Column="1" Watermark="驱动名"/>
                                                    </Grid>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="杂项">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="CardIO HID Reader支持" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvCardIo" Grid.Column="1"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="HID SmartCard支持" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvHidSmartCard" Grid.Column="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>

                                        <suki:SettingsLayoutItem Header="调试">
                                            <suki:SettingsLayoutItem.Content>
                                                <suki:GlassCard Margin="0,18,0,0" Padding="18">
                                                    <StackPanel Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Text="调试模式启动氧无" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="chkAdvAsphyxiaDebug" Grid.Column="1"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="False">
                                                            <Button x:Name="btnLoadCompat" Content="加载兼容层" Click="btnLoadCompat_Click"/>
                                                            <Button x:Name="btnUnloadCompat" Content="卸载兼容层" Click="btnUnloadCompat_Click"/>
                                                            <ComboBox x:Name="cmbCompatType" Width="150"/>
                                                        </StackPanel>
                                                        <TextBlock Text="更多功能请前往spicecfg调整" Opacity="0.7" FontSize="12" Margin="0,2,0,4" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </suki:GlassCard>
                                            </suki:SettingsLayoutItem.Content>
                                        </suki:SettingsLayoutItem>
                                    </generic:List>
                                </suki:SettingsLayout.Items>
                            </suki:SettingsLayout>
                        </suki:BusyArea>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>
                
                <suki:SukiSideMenuItem Header="显示器配置">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M1,2 L15,2 L15,11 L1,11 Z M6,12 L10,12 L10,14 L6,14 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <Grid Margin="14" RowDefinitions="Auto,*,Auto" ColumnDefinitions="360,*" ColumnSpacing="14" RowSpacing="10">
                            <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="显示器配置" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="Switch to enable display configure" Opacity="0.7"/>
                                </StackPanel>
                                <Grid Grid.Column="1"/>
                                <ToggleSwitch x:Name="tglDisplayConfigEnabled" Grid.Column="2" VerticalAlignment="Center" IsChecked="False"/>
                                <ComboBox x:Name="cmbDisplayMode" Grid.Column="3" Width="120" SelectedIndex="1">
                                    <ComboBoxItem Content="单屏"/>
                                    <ComboBoxItem Content="双屏"/>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">
                                <suki:GlassCard>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="540">
                                        <Image Source="/Assets/cabinet.png" Stretch="Uniform"/>

                                        <Canvas Width="300" Height="540" IsHitTestVisible="False">
                                            <Ellipse x:Name="dotMainGlow" Canvas.Left="124" Canvas.Top="157" Width="52" Height="52" Fill="#35FFFFFF"/>
                                            <Ellipse x:Name="dotMainCore" Canvas.Left="139" Canvas.Top="172" Width="22" Height="22" Fill="White"/>
                                            <Ellipse x:Name="dotMainSelectedRing" Canvas.Left="127" Canvas.Top="160" Width="46" Height="46" Stroke="#AAFFFFFF" StrokeThickness="2" IsVisible="False"/>

                                            <Ellipse x:Name="dotSubGlow" Canvas.Left="124" Canvas.Top="303" Width="52" Height="52" Fill="#35FFFFFF"/>
                                            <Ellipse x:Name="dotSubCore" Canvas.Left="139" Canvas.Top="318" Width="22" Height="22" Fill="White"/>
                                            <Ellipse x:Name="dotSubSelectedRing" Canvas.Left="127" Canvas.Top="306" Width="46" Height="46" Stroke="#AAFFFFFF" StrokeThickness="2" IsVisible="False"/>
                                        </Canvas>

                                        <Button x:Name="btnSelectMainScreenArea"
                                                Width="54" Height="54"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,155,0,0"
                                                Background="Transparent" BorderBrush="Transparent"
                                                Click="btnSelectMainScreenArea_Click"/>

                                        <Button x:Name="btnSelectSubScreenArea"
                                                Width="54" Height="54"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,301,0,0"
                                                Background="Transparent" BorderBrush="Transparent"
                                                Click="btnSelectSubScreenArea_Click"/>
                                    </Grid>
                                </suki:GlassCard>

                                <suki:GlassCard Grid.Row="1">
                                    <StackPanel Margin="14" Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Text="退出游戏后恢复显示器布局" VerticalAlignment="Center"/>
                                            <ToggleSwitch x:Name="chkNoRestoreRotation" Grid.Column="1" VerticalAlignment="Center" IsChecked="True"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Text="Windows触控屏设置" VerticalAlignment="Center"/>
                                            <Button x:Name="btnTouchPanel" Grid.Column="1" Content="打开" MinWidth="86" Click="btnTouchPanel_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </suki:GlassCard>
                            </Grid>

                            <suki:GlassCard Grid.Row="1" Grid.Column="1">
                                <Grid Margin="14">
                                    <StackPanel x:Name="panelNoScreenSelected" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="请选择屏幕" FontSize="18" Opacity="0.75"/>
                                    </StackPanel>

                                    <StackPanel x:Name="panelMainScreenConfig" Spacing="12" IsVisible="False">
                                        <StackPanel>
                                            <TextBlock Text="主屏设置" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="Settings of main screen" Opacity="0.7"/>
                                        </StackPanel>

                                        <suki:GlassCard>
                                            <StackPanel Margin="12" Spacing="6">
                                                <TextBlock Text="当前输出信息" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="txtMainOutputInfo" Text="未知" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </suki:GlassCard>

                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="10">
                                            <TextBlock Text="显示器" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbMainScreen" Grid.Column="1"/>
                                            <TextBlock Grid.Row="1" Text="旋转" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbRotation" Grid.Row="1" Grid.Column="1"/>
                                            <TextBlock Grid.Row="2" Text="分辨率" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbMainResolution" Grid.Row="2" Grid.Column="1"/>
                                            <TextBlock Grid.Row="3" Text="刷新率" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbMainRefreshRate" Grid.Row="3" Grid.Column="1"/>
                                        </Grid>

                                        <suki:GlassCard>
                                            <StackPanel Margin="12" Spacing="6">
                                                <TextBlock Text="启动应用参数" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="txtMainStartupInfo" Text="未配置" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </StackPanel>

                                    <StackPanel x:Name="panelSubScreenConfig" Spacing="12" IsVisible="False">
                                        <StackPanel>
                                            <TextBlock Text="副屏设置" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="Settings of sub screen" Opacity="0.7"/>
                                        </StackPanel>

                                        <suki:GlassCard>
                                            <StackPanel Margin="12" Spacing="6">
                                                <TextBlock Text="当前输出信息" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="txtSubOutputInfo" Text="未知" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </suki:GlassCard>

                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="10">
                                            <TextBlock Text="显示器" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbSubScreen" Grid.Column="1"/>
                                            <TextBlock Grid.Row="1" Text="旋转" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbSubRotation" Grid.Row="1" Grid.Column="1"/>
                                            <TextBlock Grid.Row="2" Text="分辨率" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbSubResolution" Grid.Row="2" Grid.Column="1"/>
                                            <TextBlock Grid.Row="3" Text="刷新率" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbSubRefreshRate" Grid.Row="3" Grid.Column="1"/>
                                        </Grid>

                                        <suki:GlassCard>
                                            <StackPanel Margin="12" Spacing="6">
                                                <TextBlock Text="启动应用参数" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="txtSubStartupInfo" Text="未配置" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </StackPanel>
                                </Grid>
                            </suki:GlassCard>

                            <Button x:Name="btnPreviewDisplaySettings"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Classes="Flat"
                                    HorizontalAlignment="Right"
                                    Content="预览"
                                    Click="btnPreviewDisplaySettings_Click"/>
                        </Grid>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="工具">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M2,3 L6,3 L6,1 L10,1 L10,3 L14,3 L14,14 L2,14 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <Grid Margin="14" RowDefinitions="Auto,*">
                            <TextBlock Text="常用工具" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                                <suki:GlassCard Grid.Row="0" Grid.Column="0">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="清除 Data_Mods 缓存" FontWeight="SemiBold"/>
                                        <Button x:Name="btnClearCache" Content="执行" Click="btnClearCache_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                                <suki:GlassCard Grid.Row="0" Grid.Column="1">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="添加防火墙规则" FontWeight="SemiBold"/>
                                        <Button x:Name="btnAddFirewallRule" Content="执行" Click="btnAddFirewallRule_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                                <suki:GlassCard Grid.Row="1" Grid.Column="0">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="打开音频控制面板" FontWeight="SemiBold"/>
                                        <Button x:Name="btnAudioPanel" Content="执行" Click="btnAudioPanel_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                                <suki:GlassCard Grid.Row="1" Grid.Column="1">
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="安装运行库" FontWeight="SemiBold"/>
                                        <Button x:Name="btnInstallRuntime" Content="执行" Click="btnInstallRuntime_Click"/>
                                    </StackPanel>
                                </suki:GlassCard>
                            </Grid>
                        </Grid>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="信息">
                    <suki:SukiSideMenuItem.Icon>
                        <PathIcon Data="M8,1 A7,7 0 1 1 7.99,1 Z M7.2,6 L8.8,6 L8.8,12 L7.2,12 Z M7.2,4 L8.8,4 L8.8,5.2 L7.2,5.2 Z" Width="14" Height="14"/>
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <suki:GlassCard>
                                    <Grid Margin="14" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Text="机台属性" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtCurrentVersion" Grid.Column="1" IsReadOnly="True"/>
                                        <TextBlock Text="当前游戏版本" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox x:Name="txtRevision" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsReadOnly="True"/>
                                        <TextBlock Text="启动器版本" Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox x:Name="txtLauncherVersion" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" IsReadOnly="True"/>
                                    </Grid>
                                </suki:GlassCard>

                                <suki:GlassCard>
                                    <StackPanel Margin="14" Spacing="10">
                                        <TextBlock Text="环境检测结果" FontSize="16" FontWeight="SemiBold"/>
                                        <StackPanel x:Name="panelEnvScanResults" Spacing="6"/>
                                    </StackPanel>
                                </suki:GlassCard>
                            </StackPanel>
                        </ScrollViewer>
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>
            </suki:SukiSideMenu.Items>
        </suki:SukiSideMenu>
        <Canvas IsVisible="False" IsHitTestVisible="False">
            <TextBlock x:Name="statusLabel" Text="就绪"/>
            <ProgressBar x:Name="statusProgress" Width="200" Height="14" Minimum="0" Maximum="100"/>
        </Canvas>
    </Grid>
</suki:SukiWindow>
