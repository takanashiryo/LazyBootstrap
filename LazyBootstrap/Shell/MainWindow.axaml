<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:settings="clr-namespace:LazyBootstrap.Features.Settings.Views;assembly=LazyBootstrap"
                 x:Class="LazyBootstrap.Shell.MainWindow"
                 Title="SOUND VOLTEX LazyBootstrap"
                 Width="1536" Height="864"
                 MinWidth="960" MinHeight="540"
                 BackgroundAnimationEnabled="False"
                 BackgroundStyle="Gradient"
                 CanResize="True"
                 WindowStartupLocation="CenterScreen">
    <suki:SukiWindow.Hosts>
        <suki:SukiDialogHost x:Name="DialogHost" />
        <suki:SukiToastHost x:Name="ToastHost" />
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.Styles>
        <Style Selector="suki|SukiSideMenu Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.FaIcon">
            <Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolidFamily}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Padding" Value="0,1,0,1" />
            <Setter Property="LineHeight" Value="20" />
        </Style>


        <Style Selector="suki|SukiWindow /template/ suki|GlassCard#PART_TitleBarBackground">
            <Setter Property="Background" Value="#33000000" />
        </Style>

        <Style Selector="suki|SukiSideMenu /template/ suki|GlassCard#Glass">
            <Setter Property="Background" Value="#33000000" />
        </Style>

        <Style Selector="suki|SukiSideMenu /template/ Border#ContentBorder">
            <Setter Property="Background" Value="#22000000" />
        </Style>

    </suki:SukiWindow.Styles>

    <Grid>
        <suki:BusyArea x:Name="GlobalBusyArea" BusyText="">
            <Grid>
                <Image Source="avares://LazyBootstrap/Assets/Images/background.jpg"
                       Stretch="UniformToFill"
                       Opacity="0.05"
                       IsHitTestVisible="False" />

                <suki:SukiSideMenu x:Name="MainSideMenu" IsSearchEnabled="False">
                    <suki:SukiSideMenu.Items>
                        <suki:SukiSideMenuItem Header="启动">
                            <suki:SukiSideMenuItem.Icon>
                                <TextBlock Classes="FaIcon" Text="&#xF04B;" FontSize="14" />
                            </suki:SukiSideMenuItem.Icon>
                            <suki:SukiSideMenuItem.PageContent>
                                <ContentControl x:Name="LaunchPageHost" />
                            </suki:SukiSideMenuItem.PageContent>
                        </suki:SukiSideMenuItem>

                        <suki:SukiSideMenuItem Header="设定">
                            <suki:SukiSideMenuItem.Icon>
                                <TextBlock Classes="FaIcon" Text="&#xF013;" FontSize="14" />
                            </suki:SukiSideMenuItem.Icon>
                            <suki:SukiSideMenuItem.PageContent>
                                <ContentControl x:Name="SettingsPageHost" />
                            </suki:SukiSideMenuItem.PageContent>
                        </suki:SukiSideMenuItem>

                        <suki:SukiSideMenuItem Header="显示器配置">
                            <suki:SukiSideMenuItem.Icon>
                                <TextBlock Classes="FaIcon" Text="&#xF390;" FontSize="14" />
                            </suki:SukiSideMenuItem.Icon>
                            <suki:SukiSideMenuItem.PageContent>
                                <ContentControl x:Name="DisplayPageHost" />
                            </suki:SukiSideMenuItem.PageContent>
                        </suki:SukiSideMenuItem>

                        <suki:SukiSideMenuItem Header="工具">
                            <suki:SukiSideMenuItem.Icon>
                                <TextBlock Classes="FaIcon" Text="&#xF552;" FontSize="14" />
                            </suki:SukiSideMenuItem.Icon>
                            <suki:SukiSideMenuItem.PageContent>
                                <ContentControl x:Name="ToolsPageHost" />
                            </suki:SukiSideMenuItem.PageContent>
                        </suki:SukiSideMenuItem>

                        <suki:SukiSideMenuItem Header="更新">
                            <suki:SukiSideMenuItem.Icon>
                                <TextBlock Classes="FaIcon" Text="&#xF2F1;" FontSize="14" />
                            </suki:SukiSideMenuItem.Icon>
                            <suki:SukiSideMenuItem.PageContent>
                                <ContentControl x:Name="UpdatePageHost" />
                            </suki:SukiSideMenuItem.PageContent>
                        </suki:SukiSideMenuItem>

                        <suki:SukiSideMenuItem Header="信息">
                            <suki:SukiSideMenuItem.Icon>
                                <TextBlock Classes="FaIcon" Text="&#xF05A;" FontSize="14" />
                            </suki:SukiSideMenuItem.Icon>
                            <suki:SukiSideMenuItem.PageContent>
                                <ContentControl x:Name="DiagnosticPageHost" />
                            </suki:SukiSideMenuItem.PageContent>
                        </suki:SukiSideMenuItem>

                        <suki:SukiSideMenuItem Header="关于">
                            <suki:SukiSideMenuItem.Icon>
                                <TextBlock Classes="FaIcon" Text="&#xF128;" FontSize="14" />
                            </suki:SukiSideMenuItem.Icon>
                            <suki:SukiSideMenuItem.PageContent>
                                <ContentControl x:Name="AboutPageHost" />
                            </suki:SukiSideMenuItem.PageContent>
                        </suki:SukiSideMenuItem>
                    </suki:SukiSideMenu.Items>
                </suki:SukiSideMenu>
            </Grid>
        </suki:BusyArea>

        <Grid x:Name="RuntimeInstallOverlay" IsVisible="False" Opacity="1" ZIndex="100">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseInOut" />
                </Transitions>
            </Grid.Transitions>
            <Border Background="{DynamicResource SukiPopupBackground}" Opacity="0.72" />
            <suki:GlassCard HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="26"
                            CornerRadius="22"
                            MinWidth="360">
                <StackPanel Spacing="20" ClipToBounds="False">
                    <TextBlock Text="运行库安装进度"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <StackPanel Width="320" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                            <TextBlock x:Name="RuntimeStatusText"
                                       Text=""
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="RuntimeProgressValueText"
                                       Grid.Column="1"
                                       Text=""
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold" />
                        </Grid>
                        <ProgressBar x:Name="RuntimeProgressBar"
                                     Height="14"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0" />
                        <TextBlock Text="请耐心等待，进度条没有卡死"
                                   HorizontalAlignment="Center"
                                   Opacity="0.72"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </suki:GlassCard>
        </Grid>
    </Grid>
</suki:SukiWindow>