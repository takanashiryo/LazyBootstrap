<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>LazyBootstrap</RootNamespace>
    <AssemblyName>LazyBootstrap</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\Resources\vii\vii_icon.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>26.3</Version>
    <AssemblyTitle>Launcher for Lazy SDVX</AssemblyTitle>
    <Description>A tool made for SDVX with spice2x</Description>
    <Company>LazyBootstrap - Lazy SDVX</Company>
    <Copyright>Copyright © 2025 Takanashi Ryo</Copyright>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
    <PackageReference Include="NAudio.Asio" Version="2.3.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Management" Version="10.0.7" />
    <ProjectReference Include="..\Suki UI\SukiUI\SukiUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Fonts\*.otf" />
    <AvaloniaResource Include="Assets\Images\*.png" />
    <AvaloniaResource Include="Assets\Images\*.jpg" />
    <AvaloniaResource Include="Assets\Images\*.jpeg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Resources\vii\vii_icon.ico">
      <Link>vii_icon.ico</Link>
    </None>
    <None Include="Public\7z\7za.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>7za.exe</TargetPath>
    </None>
    <None Include="Public\7z\7za.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>7za.dll</TargetPath>
    </None>
    <None Include="Public\7z\7zxa.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>7zxa.dll</TargetPath>
    </None>
    <None Include="Public\libs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>libs\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LazyBootstrap.MediaUpdater\MediaUpdatePaths.cs" Link="MediaUpdate\MediaUpdatePaths.cs" />
    <Compile Include="..\LazyBootstrap.MediaUpdater\MediaUpdateSecurity.cs" Link="MediaUpdate\MediaUpdateSecurity.cs" />
    <Compile Include="..\LazyBootstrap.MediaUpdater\MediaUpdateConstants.cs" Link="MediaUpdate\MediaUpdateConstants.cs" />
    <Compile Include="..\LazyBootstrap.MediaUpdater\MediaUpdateArguments.cs" Link="MediaUpdate\MediaUpdateArguments.cs" />
    <Compile Include="..\LazyBootstrap.MediaUpdater\MediaUpdateRunner.cs" Link="MediaUpdate\MediaUpdateRunner.cs" />
  </ItemGroup>

</Project>
