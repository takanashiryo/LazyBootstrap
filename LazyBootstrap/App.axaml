<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             x:Class="LazyBootstrap.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="DefaultFontFamily">avares://LazyBootstrap/Assets/HarmonyOS_Sans_SC_Medium.ttf#HarmonyOS Sans SC Medium, Microsoft YaHei UI, Segoe UI</FontFamily>
            <FontFamily x:Key="FontAwesomeSolidFamily">avares://LazyBootstrap/Assets/Font Awesome 7 Free-Solid-900.otf#Font Awesome 7 Free Solid</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LazyBootstrap/Styles/SukiDialogOverride.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <sukiUi:SukiTheme Locale="zh-CN" ThemeColor="Green" />
        <Style Selector="Control">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        </Style>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
        </Style>
    </Application.Styles>
</Application>
