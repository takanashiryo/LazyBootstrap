<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LazyBootstrap.AdvancedOptionsWindow"
        Title="高级选项"
        Width="420" Height="560"
        MinWidth="400" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10">
                警告：
在调整高级选项前请确认你了解每个选项的作用
            </TextBlock>

            <HeaderedContentControl Margin="0,0,0,10">
                <HeaderedContentControl.Header>
                    <TextBlock Text="调试选项" FontWeight="Bold"/>
                </HeaderedContentControl.Header>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="10,5">
                    <StackPanel>
                        <CheckBox x:Name="chkNetDump" Content="启用 NetDump" Margin="0,5"/>
                        <CheckBox x:Name="chkAsphyxiaDebug" Content="以调试模式启动氧无" Margin="0,5"/>
                    </StackPanel>
                </Border>
            </HeaderedContentControl>

            <HeaderedContentControl Margin="0,0,0,10">
                <HeaderedContentControl.Header>
                    <TextBlock Text="高级选项" FontWeight="Bold"/>
                </HeaderedContentControl.Header>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="10,5">
                    <StackPanel>
                        <CheckBox x:Name="chkDisableSubDisplay" Content="禁用副屏" Margin="0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="窗口化模式" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbWindowMode" Width="140">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="无边框"/>
                                <ComboBoxItem Content="可变窗口"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="chkPCoreOptimization" Content="大小核优化" Margin="0,5"/>
                        <CheckBox x:Name="chkSubBorderless" Content="副屏无边框" Margin="0,5"/>
                        <CheckBox x:Name="chkShowCursorTouchSim" Content="显示光标&amp;启用触控模拟" Margin="0,5"/>
                    </StackPanel>
                </Border>
            </HeaderedContentControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                <Button x:Name="btnOk" Content="确定" Width="88" Height="30" Margin="5,0"
                        Click="btnOk_Click"/>
                <Button x:Name="btnCancel" Content="取消" Width="88" Height="30" Margin="5,0"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
