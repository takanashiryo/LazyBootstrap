<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        x:Class="LazyBootstrap.ServerManagementWindow"
        Title="服务器管理"
        Width="460" Height="280"
        MinWidth="420" MinHeight="260"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <suki:SukiWindow.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.form-label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </suki:SukiWindow.Styles>

    <Grid Margin="16"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          ColumnDefinitions="96,*">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="form-label" Text="预设：" Margin="0,0,10,8"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbPreset" Margin="0,0,0,8" SelectionChanged="cmbPreset_SelectionChanged">
            <ComboBoxItem Content="默认"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="form-label" Text="服务器地址：" Margin="0,0,10,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtServerAddress" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="form-label" Text="PCB ID：" Margin="0,0,10,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPcbId"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="btnOk" Content="确定" Width="88" Height="30" Margin="5,0"
                    Click="btnOk_Click"/>
            <Button x:Name="btnCancel" Content="取消" Width="88" Height="30" Margin="5,0"
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</suki:SukiWindow>
